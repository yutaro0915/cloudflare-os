{
  "name": "@gadgets/workshop-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "tokens:check": "dtokens check src/design-tokens.json src/design-tokens.dark.json --scope lint",
    "tokens:build": "pnpm run tokens:check && dtokens convert src/design-tokens.json src/design-tokens.dark.json --outform css --out src/design-tokens.generated.css",
    "dev": "pnpm run tokens:build && vite",
    "build:assets": "pnpm run tokens:build && vite build",
    "build": "pnpm run tokens:build && tsc && vite build",
    "types:check": "pnpm run tokens:check && tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.9.0",
    "@gadgets/error-reporting": "workspace:*",
    "@gadgets/workshop-shared": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.18",
    "capnweb": "^0.8.0",
    "hash-wasm": "^4.12.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@design-token-kit/cli": "1.8.0",
    "@tanstack/router-plugin": "^1.168.23",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
